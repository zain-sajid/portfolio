---
import { getCollection } from 'astro:content';
import Container from '@/components/Container.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import ArrowCard from '@/components/ArrowCard.astro';
import Link from '@/components/Link.astro';
import { SITE, HOME, SOCIALS } from '@/consts';
import AccordionDemo from '@/components/AccordionDemo';
import Arrow from '@/components/icons/Arrow.astro';
import LifeInWeeks from '@/components/LifeInWeeks.astro';

const blog = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection('projects'))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allwork = (await getCollection('work'))
  .sort(
    (a, b) =>
      new Date(b.data.dateStart).valueOf() -
      new Date(a.data.dateStart).valueOf()
  )
  .slice(0, SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h4 class="animate font-semibold text-black dark:text-white">
      Hey, I'm Zain <span class="text-xl">👋🏻</span>
    </h4>

    <div class="space-y-16">
      <section>
        <article class="space-y-4">
          <p class="animate">
            A product-focused full-stack developer with expertise in React,
            Node.js, and Next.js. Passionate about crafting innovative products,
            I bring ideas to life with clean, efficient code. From responsive
            frontends to robust backends, I strive to build great user
            experiences on the web.
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">Work</h5>
          <Link href="/work"> See all work </Link>
        </div>

        {
          work.map((entry) => (
            <AccordionDemo client:visible entry={entry}>
              <article slot="content" class="[&>*]:mt-0">
                <entry.Content />
              </article>
            </AccordionDemo>
          ))
        }
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">Projects</h5>
          <Link href="/projects"> See all projects </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {
            projects.map((project) => (
              <li>
                <ArrowCard entry={project} />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">Blogs</h5>
          <Link href="/blog"> See all blogs </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {
            blog.map((post) => (
              <li>
                <ArrowCard entry={post} />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-6">
        <LifeInWeeks birthDate={new Date('2000-12-11')} />
      </section>

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">Connect</h5>
        <article>
          <p>
            If you want to get in touch with me about something or just to say
            hi, reach out on social media or send me an email.
          </p>
        </article>

        <a
          href="https://calendly.com/zainsajid/30min"
          target="_blank"
          rel="noopener noreferrer"
          class="relative group w-fit flex pl-3 pr-8 py-1.5 flex-nowrap rounded border border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out"
        >
          <div class="text-sm">Book a call</div>
          <Arrow class="size-4" />
        </a>

        <ul class="flex flex-wrap gap-4">
          {
            SOCIALS.map((SOCIAL) => (
              <li class="text-nowrap">
                <Link
                  href={SOCIAL.HREF}
                  external
                  aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}
                >
                  {SOCIAL.NAME}
                </Link>
              </li>
            ))
          }
          <li class="line-clamp-1">
            <Link
              href={`mailto:${SITE.EMAIL}`}
              aria-label={`Email ${SITE.NAME}`}
            >
              email
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
