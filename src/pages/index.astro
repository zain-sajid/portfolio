---
import { getCollection } from 'astro:content';
import Container from '@/components/Container.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import ArrowCard from '@/components/ArrowCard.astro';
import Link from '@/components/Link.astro';
import { SITE, HOME, SOCIALS } from '@/consts';
import AccordionDemo from '@/components/AccordionDemo';
import Arrow from '@/components/icons/Arrow.astro';
import LifeInWeeks from '@/components/LifeInWeeks.astro';
import Panel from '@/components/Panel.astro';
import Separator from '@/components/Separator.astro';
import Overview from '@/components/Overview.astro';
import { byRecency } from '@/lib/utils';

const blog = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection('projects'))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allwork = (await getCollection('work'))
  .sort(byRecency)
  .slice(0, SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION} flush>
  <Container>
    <Panel class="animate">
      <article>
        <p>
          A product-focused full-stack developer with expertise in React,
          Node.js, and Next.js. Passionate about crafting innovative products,
          I bring ideas to life with clean, efficient code. From responsive
          frontends to robust backends, I strive to build great user
          experiences on the web.
        </p>
      </article>
    </Panel>
    <div class="animate">
      <Separator />
      <Overview />
    </div>
    <div class="animate">
      <Separator />
      <Panel id="work" title="Work">
        <Link slot="action" href="/work"> See all work </Link>
        <div>
          {
            work.map((entry, i) => (
              <AccordionDemo
                client:visible
                entry={entry}
                last={i === work.length - 1}
              >
                <article slot="content" class="[&>*]:mt-0">
                  <entry.Content />
                </article>
              </AccordionDemo>
            ))
          }
        </div>
      </Panel>
    </div>
    <div class="animate">
      <Separator />
      <Panel id="projects" title="Projects">
        <Link slot="action" href="/projects"> See all projects </Link>
        <ul class="flex flex-col gap-4">
          {
            projects.map((project) => (
              <li>
                <ArrowCard entry={project} />
              </li>
            ))
          }
        </ul>
      </Panel>
    </div>
    <div class="animate">
      <Separator />
      <Panel id="blog" title="Blogs">
        <Link slot="action" href="/blog"> See all blogs </Link>
        <ul class="flex flex-col gap-4">
          {
            blog.map((post) => (
              <li>
                <ArrowCard entry={post} />
              </li>
            ))
          }
        </ul>
      </Panel>
    </div>
    <div class="animate">
      <Separator />
      <Panel>
        <LifeInWeeks birthDate={new Date('2000-12-11')} />
      </Panel>
    </div>
    <div class="animate">
      <Separator />
      <Panel id="connect" title="Connect">
        <div class="space-y-4">
          <article>
            <p>
              If you want to get in touch with me about something or just to say
              hi, reach out on social media or send me an email.
            </p>
          </article>

          <a
            href={SITE.CALL_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="relative group w-fit flex pl-3 pr-8 py-1.5 flex-nowrap rounded border border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white hover-glow transition duration-300 ease-in-out"
          >
            <div class="text-sm">Book a call</div>
            <Arrow class="size-4" />
          </a>

          <ul class="flex flex-wrap gap-4">
            {
              SOCIALS.map((SOCIAL) => (
                <li class="text-nowrap">
                  <Link
                    href={SOCIAL.HREF}
                    external
                    aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}
                  >
                    {SOCIAL.NAME}
                  </Link>
                </li>
              ))
            }
            <li class="line-clamp-1">
              <Link
                href={`mailto:${SITE.EMAIL}`}
                aria-label={`Email ${SITE.NAME}`}
              >
                email
              </Link>
            </li>
          </ul>
        </div>
      </Panel>
    </div>
  </Container>
</PageLayout>
