---
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import Container from '@/components/Container.astro';
import { byRecency, dateRange } from '@/lib/utils';
import { WORK } from '@/consts';

const collection = (await getCollection('work')).sort(byRecency);

const work = await Promise.all(
  collection.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);
---

<PageLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate text-3xl font-medium tracking-tight text-black dark:text-white">Work</div>
      <ul class="flex flex-col space-y-4">
        {
          work.map((entry) => (
            <li class="animate">
              <div class="text-lg font-semibold text-black dark:text-white">
                {entry.data.companyURL ? (
                  <a href={entry.data.companyURL} target="_blank" rel="noopener noreferrer" class="hover:underline">
                    {entry.data.company}
                  </a>
                ) : (
                  entry.data.company
                )}
              </div>
              <div class="text-base opacity-75">
                {entry.data.role}
                {entry.data.employmentType && ` · ${entry.data.employmentType}`}
              </div>
              <div class="text-base opacity-75">
                {dateRange(entry.data.dateStart, entry.data.dateEnd)}
              </div>
              <article>
                <entry.Content />
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</PageLayout>
